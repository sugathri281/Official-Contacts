rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the link can READ (view contacts, no login needed).
    // Only a signed-in staff account (created in Firebase Console → Authentication)
    // can WRITE (add, edit, delete contacts or the ULB mapping table).
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
